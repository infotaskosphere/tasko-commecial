# ============================================================
# Taskosphere Commercial - Backend Environment
# AIWeave / FastAPI / MongoDB / CORS
# NEVER commit the real .env file.
# ============================================================

# -------------------------
# Runtime
# -------------------------
ENV_MODE=production

# -------------------------
# MongoDB
# Use the variable already configured by your deployment.
# MONGODB_URI is preferred; MONGO_URL is retained for compatibility.
# -------------------------
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>/<DATABASE>?retryWrites=true&w=majority
MONGO_URL=
MONGODB_DB_NAME=taskosphere
DB_NAME=taskosphere

# -------------------------
# Authentication
# Must be a long random secret.
# Keep the same value across deployments that must validate existing JWTs.
# -------------------------
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>

# -------------------------
# AIWeave credential encryption
# Fernet key used to encrypt provider credentials stored in MongoDB.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: changing this after accounts have been connected makes the
# previously encrypted AI provider credentials undecryptable.
# -------------------------
AIWEAVE_CREDENTIAL_ENCRYPTION_KEY=<GENERATE_A_FERNET_KEY>

# -------------------------
# CORS
# Add your production frontend explicitly.
# The backend already allows *.vercel.app and *.onrender.com through its
# origin regex, but keep this explicit value for the canonical frontend.
# Multiple origins are comma-separated.
# -------------------------
CORS_ALLOWED_ORIGINS=https://tasko-commercial-frontend.vercel.app

# -------------------------
# Optional MCA integration
# -------------------------
MCA_API_KEY=
MCA_API_BASE_URL=https://api.mca.gov.in/MCA21/api/v1

# -------------------------
# Existing Taskosphere email / Brevo integration
# Keep these if your current deployment already uses email features.
# -------------------------
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
SENDER_EMAIL=
SENDER_NAME=Taskosphere

# -------------------------
# Existing SaaS bootstrap admin
# Optional. Only use if the existing commercial bootstrap flow requires it.
# -------------------------
SAAS_BOOTSTRAP_ADMIN_EMAIL=
SAAS_BOOTSTRAP_ADMIN_PASSWORD=
SAAS_SESSION_TTL_DAYS=7

# ============================================================
# AI PROVIDER KEYS - SERVER MANAGED
# ============================================================
# IMPORTANT:
# Customer/licensee users do NOT enter AI API keys in AIWeave.
# They only sign in to Taskosphere using the normal application login.
# These provider credentials stay on the backend/Render environment.
#
# Add only the providers you want AIWeave to use.
# For multiple accounts/keys of the same provider, use _2, _3, etc.
# Example:
# AIWEAVE_OPENAI_API_KEY=key-one
# AIWEAVE_OPENAI_API_KEY_2=key-two
# AIWEAVE_OPENAI_API_KEY_3=key-three
#
# AIWeave never sends these secrets to the frontend.
# ============================================================

AIWEAVE_OPENAI_API_KEY=
AIWEAVE_OPENAI_API_KEY_2=
AIWEAVE_OPENAI_API_KEY_3=

AIWEAVE_GEMINI_API_KEY=
AIWEAVE_GEMINI_API_KEY_2=
AIWEAVE_GEMINI_API_KEY_3=

AIWEAVE_ANTHROPIC_API_KEY=
AIWEAVE_ANTHROPIC_API_KEY_2=
AIWEAVE_ANTHROPIC_API_KEY_3=

AIWEAVE_XAI_API_KEY=
AIWEAVE_XAI_API_KEY_2=

AIWEAVE_KIMI_API_KEY=
AIWEAVE_KIMI_API_KEY_2=

AIWEAVE_DEEPSEEK_API_KEY=
AIWEAVE_DEEPSEEK_API_KEY_2=

AIWEAVE_QWEN_API_KEY=
AIWEAVE_QWEN_API_KEY_2=

AIWEAVE_MISTRAL_API_KEY=
AIWEAVE_MISTRAL_API_KEY_2=

AIWEAVE_GROQ_API_KEY=
AIWEAVE_GROQ_API_KEY_2=

AIWEAVE_OPENROUTER_API_KEY=
AIWEAVE_OPENROUTER_API_KEY_2=

AIWEAVE_TOGETHER_API_KEY=
AIWEAVE_TOGETHER_API_KEY_2=

# Optional local provider
AIWEAVE_OLLAMA_BASE_URL=

# ============================================================
# AIWeave architecture
# ============================================================
# End users only authenticate with their Taskosphere account/email.
# Provider credentials are centrally controlled by the platform operator.
# AIWeave automatically discovers enabled models and can fail over between
# configured provider keys according to the routing policy.
# ============================================================
# AIWeave itself does NOT require provider API keys in these environment
# variables when accounts are connected through:
# AIWeave -> Settings -> Providers -> Connect account
#
# AIWeave encrypts the credential server-side using
# AIWEAVE_CREDENTIAL_ENCRYPTION_KEY.
#
# Therefore DO NOT add OPENAI_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY
# here just to make AIWeave work.
#
# Existing non-AIWeave application endpoints may still use their own
# provider environment variables. Preserve those existing variables if
# other Taskosphere features depend on them.
# ============================================================

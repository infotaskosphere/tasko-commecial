# Taskosphere licensing service
LICENSE_PORT=3100
MASTER_CONSOLE_TOKEN=replace-with-a-long-random-secret
LICENSE_ALLOWED_ORIGIN=https://your-taskosphere-domain.example
LICENSE_STORE_PATH=./backend/.data/licenses.json

# Main Taskosphere application -> central licensing service
LICENSE_API_URL=http://localhost:3100/api
LICENSE_ACTIVATION_PATH=./backend/.data/activation.json
LICENSE_CHECK_INTERVAL_SECONDS=60
LICENSE_OFFLINE_GRACE_MINUTES=120

# Set true only after customer activation has been tested in the target deployment.
# When true, the main Taskosphere API rejects requests for modules not present in the active license.
LICENSE_ENFORCEMENT=false

# Frontend build-time URL for the dedicated licensing service used by Master Console.
# Local development: http://localhost:3100/api
# Production: https://your-licensing-service.example/api
VITE_LICENSE_API_URL=http://localhost:3100/api
